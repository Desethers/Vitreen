{
  "name": "galerie-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:webpack": "next dev --webpack -p 3000",
    "dev:studio": "cd studio && npm run dev",
    "dev:clean": "(lsof -ti tcp:3000 2>/dev/null; lsof -ti tcp:3001 2>/dev/null; lsof -ti tcp:3002 2>/dev/null) | sort -u | xargs kill -9 2>/dev/null || true && rm -f .next/dev/lock && next dev --webpack -p 3000",
    "build": "npm run studio:build && next build",
    "studio:build": "cd studio && npm install && npm run build",
    "studio:dev": "cd studio && npm install && npm run dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "prepare": "simple-git-hooks",
    "generate:variations": "tsx scripts/generate-variations.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npx prettier --check --ignore-unknown $(git diff --cached --name-only --diff-filter=ACM)"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.36.0",
    "lucide-react": "^1.16.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
